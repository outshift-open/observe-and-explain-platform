# Minimal environment template for Docker Compose worker queue mode
# Copy to .env before running: cp .env.template .env

# Core infrastructure
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
NEO4J_PASSWORD=testpassword # legit:ignore

# Shared worker settings
EMBEDDING_MODEL=azure/text-embedding-3-small

# Queue wiring for analysis pipeline
ANALYSIS_INPUT_QUEUE=new_session_to_analysis

# Analysis worker tuning
ANALYSIS_CONCURRENCY=3
ANALYSIS_MAX_CONCURRENCY=12

# Optional analysis layer config files (inside container paths or mounted files)
ANOMALY_CONFIG_FILE=
CONSISTENCY_CONFIG_FILE=
NORMAL_BEHAVIOUR_CONFIG_FILE=

# OPENAI_API_KEY=
AI_GATEWAY_API_KEY=
LLM_MODEL_NAME=gpt-4o          # or azure/gpt-4o for Azure
LLM_BASE_MODEL_URL_MCE=https://api.openai.com/v1   # for non-Azure OpenAI; omit for Azure

# Clickhouse (used directly by norm/embedding/other workers via oxp API layer)
CLICKHOUSE_HOST=host.docker.internal
CLICKHOUSE_PORT=8123
CLICKHOUSE_USERNAME=admin
CLICKHOUSE_PASSWORD=admin
NEO4J_AUTH=neo4j/testpassword # legit:ignore