# Environment configuration for grouping-worker
# Copy this to .env and customize as needed

# RabbitMQ Configuration
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Queue Configuration
GROUPING_INPUT_QUEUE=new_session_to_grouping
# GROUPING_OUTPUT_QUEUE=new_session_to_normal_behaviour

# Optional: Feedback queue
# GROUPING_FEEDBACK_QUEUE=feedback

# Neo4j Configuration (required)
NEO4J_HOST=localhost
NEO4J_PORT=7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# Embedding model used to retrieve session embeddings from Neo4j
GROUPING_EMBEDDING_MODEL=azure/text-embedding-3-small

# Grouping parameters
GROUPING_MAX_DISTANCE=0.3
GROUPING_MAX_NEIGHBORS=10

# Logging
LOG_LEVEL=INFO
