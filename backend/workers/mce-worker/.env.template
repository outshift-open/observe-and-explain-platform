# Environment configuration for mce-worker
# Copy this to .env and customize as needed

# RabbitMQ Configuration
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Queue Configuration
MCE_INPUT_QUEUE=new_session_to_mce
MCE_OUTPUT_QUEUE=new_session_to_grouping

# Optional: Feedback queue for processing notifications
# MCE_FEEDBACK_QUEUE=feedback

# MCE Configuration
# MCE_CONFIG_PATH=/path/to/mce_config.yaml

# Neo4j Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
NEO4J_DB=neo4j

# LLM Configuration (for LLM-as-a-judge metrics)
# OPENAI_API_KEY=sk-...
# LLM_MODEL_NAME=gpt-4o
# LLM_BASE_MODEL_URL_MCE=https://api.openai.com/v1

# Worker Configuration
# MCE_MAX_SESSIONS=-1  # -1 for unlimited
# MCE_DEBUG=false      # Set to true for debug output

# Logging
LOG_LEVEL=INFO
