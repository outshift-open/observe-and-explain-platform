# norm-worker-new environment template
# Copy to .env before running: cp .env.template .env

# ── ClickHouse ────────────────────────────────────────────────────────────────
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=default

# ── Neo4j ─────────────────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_AUTH=neo4j/change-me
NEO4J_DB=neo4j

# ── RabbitMQ ──────────────────────────────────────────────────────────────────
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# ── Queue names (optional — defaults shown) ───────────────────────────────────
NORM_INPUT_QUEUE=new_session_in
NORM_OUTPUT_QUEUE=new_session_to_mce,new_session_to_embedding

# ── Worker tuning (optional) ──────────────────────────────────────────────────
NORM_MAX_INFLIGHT_MESSAGES=32
