# Environment configuration for consistency-worker
# Copy this to .env and customize as needed

# RabbitMQ Configuration
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Queue Configuration
CONSISTENCY_INPUT_QUEUE=new_session_to_consistency

# Optional: Feedback queue
# CONSISTENCY_FEEDBACK_QUEUE=feedback

# Neo4j Configuration (required)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
NEO4J_DB=neo4j

# Embedding model used to retrieve session data from Neo4j
EMBEDDING_MODEL=azure/text-embedding-3-small

# Optional: path to layers config YAML
# CONSISTENCY_CONFIG_FILE=/tmp/consistency-config.yaml

# Logging
LOG_LEVEL=INFO
