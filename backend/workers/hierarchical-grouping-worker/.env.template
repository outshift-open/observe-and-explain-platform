# RabbitMQ Configuration
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Queue Configuration
HIERARCHICAL_GROUPING_INPUT_QUEUE=new_session_to_periodic_grouping
HIERARCHICAL_GROUPING_OUTPUT_QUEUE=new_session_to_analysis

# Optional: Feedback queue for processing notifications
# HIERARCHICAL_GROUPING_FEEDBACK_QUEUE=worker_feedback

# Neo4j Configuration
NEO4J_URI=bolt://localhost:7687
# Or use host/port separately:
# NEO4J_HOST=localhost
# NEO4J_PORT=7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# LLM Configuration
LLM_BASE_MODEL_URL_MCE=
LLM_MODEL_NAME=azure/gpt-4o
OPENAI_API_KEY=

# Grouping Configuration
HIERARCHICAL_GROUPING_EMBEDDING_MODEL=azure/text-embedding-3-small
HIERARCHICAL_GROUPING_MAX_NEIGHBORS=10
HIERARCHICAL_GROUPING_MIN_SAMPLES=20
HIERARCHICAL_GROUPING_MAX_DISTANCE=0.15

# Logging
LOG_LEVEL=INFO