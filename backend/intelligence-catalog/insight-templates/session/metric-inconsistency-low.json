{
  "nameTemplate": "Low metric consistency risk on $metricName",
  "descriptionTemplate": "Session $sessionId has non-anomalous $metricName=$metricValue, and group consistency is low ($meanValue < $lowThreshold).",
  "kgQuery": [
    "MATCH (s:Session)-[:belongsToSemanticGroup]->(sg:SemanticGroup)-[:hasConsistencyReport]->(cr:ConsistencyReport)",
    "WHERE cr.dataType = 'metric'",
    "MATCH (s)-[:hasMetric]->(m:Metric)",
    "WHERE toString(cr.metadata) CONTAINS m.metricName",
    "OPTIONAL MATCH (sg)-[:hasAnomalyReport]->(ar:AnomalyReport)",
    "  WHERE ar.dataType = 'metric'",
    "    AND ar.metricName = m.metricName",
    "WITH s, sg, cr, m, ar, 0.45 AS criticalThreshold, 0.60 AS lowThreshold,",
    "     CASE",
    "       WHEN ar IS NULL THEN false",
    "       ELSE toString(ar.outliersValues) CONTAINS s.sessionId",
    "     END AS isOutlier,",
    "     toFloat(cr.mean) AS consistencyValue",
    "WHERE isOutlier = false",
    "  AND consistencyValue > criticalThreshold",
    "  AND consistencyValue <= lowThreshold",
    "RETURN s.sessionId AS sessionId,",
    "  sg.id AS groupId,",
    "  coalesce(sg.groupName, 'unknown') AS groupName,",
    "  m.metricName AS metricName,",
    "  round(toFloat(m.metricResult), 4) AS metricValue,",
    "  round(consistencyValue, 4) AS meanValue,",
    "  round(lowThreshold, 2) AS lowThreshold,",
    "  'low' AS severity,",
    "  'Consistency is low' AS severityReason,",
    "  'P3' AS priority"
  ],
  "labels": ["Consistency", "Metric", "Reliability"],
  "scope": "Session",
  "priority": "$priority",
  "targetNodeId": "$sessionId"
}
