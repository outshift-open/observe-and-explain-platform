{
  "nameTemplate": "High metric consistency risk on $metricName",
  "descriptionTemplate": "Session $sessionId has non-anomalous $metricName=$metricValue, but group consistency is critically low ($meanValue < $criticalThreshold).",
  "kgQuery": [
    "MATCH (sg:SemanticGroup)-[:hasConsistencyReport]->(cr:ConsistencyReport)",
    "MATCH (sg)-[:containsSession]->(s:Session)",
    "WHERE cr.dataType = 'metric'",
    "MATCH (s)-[:hasMetric]->(m:Metric)",
    "WHERE toString(cr.metadata) CONTAINS m.metricName",
    "OPTIONAL MATCH (sg)-[:hasAnomalyReport]->(ar:AnomalyReport)",
    "  WHERE ar.dataType = 'metric'",
    "    AND ar.metricName = m.metricName",
    "WITH s, sg, cr, m, ar, 0.45 AS criticalThreshold,",
    "     CASE",
    "       WHEN ar IS NULL THEN false",
    "       ELSE toString(ar.outliersValues) CONTAINS s.sessionId",
    "     END AS isOutlier,",
    "     toFloat(cr.mean) AS consistencyValue",
    "WHERE isOutlier = false",
    "  AND consistencyValue <= criticalThreshold",
    "RETURN s.sessionId AS sessionId,",
    "  sg.id AS groupId,",
    "  coalesce(sg.groupName, 'unknown') AS groupName,",
    "  m.metricName AS metricName,",
    "  round(toFloat(m.metricResult), 4) AS metricValue,",
    "  round(consistencyValue, 4) AS meanValue,",
    "  round(criticalThreshold, 2) AS criticalThreshold,",
    "  'high' AS severity,",
    "  'Consistency is critically low' AS severityReason,",
    "  'P2' AS priority"
  ],
  "labels": ["Reliability"],
  "scope": "Session",
  "priority": "$priority",
  "targetNodeId": "$sessionId"
}
