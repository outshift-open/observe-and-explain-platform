{
  "name": "oxp-ui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "yarn run dev",
    "dev": "VITE_APP_CLIENT_PORT=3000 vite",
    "build": "tsc && vite build",
    "lint:check": "eslint . && prettier \"**/*.+(ts*|js*)\" --check",
    "lint": "eslint . --fix && prettier \"**/*.+(ts*|js*)\" --write",
    "format": "prettier \"**/*.+(ts*|js*)\" --write",
    "preview": "vite preview",
    "prepare": "husky && husky install"
  },
  "dependencies": {
    "@antv/g2": "^5.4.8",
    "@antv/g6": "^5.0.51",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^7.0.1",
    "@mui/lab": "^7.0.0-beta.10",
    "@mui/material": "^7.0.1",
    "@mui/system": "^6.4.3",
    "@mui/x-date-pickers": "^7.26.0",
    "@mui/x-tree-view": "^8.4.0",
    "@open-ui-kit/core": "3.0.0",
    "@tanstack/react-query": "^5.90.20",
    "@uiw/react-json-view": "^2.0.0-alpha.41",
    "@xyflow/react": "^12.6.4",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.13",
    "elkjs": "^0.10.0",
    "material-react-table": "^3.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-error-boundary": "^4.1.2",
    "react-router-dom": "^7.5.1",
    "react-spring": "^10.0.1",
    "vite-plugin-svgr": "^4.3.0",
    "zustand": "5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.24.1",
    "@typescript-eslint/parser": "^8.24.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/browser-playwright": "^4.1.5",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^9.31.0",
    "eslint-config-prettier": "^10.0.2",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "playwright": "^1.59.1",
    "prettier": "3.5.1",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.5",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">= 13.8.0",
    "npm": ">= 6.14.4",
    "yarn": ">= 1.15.2"
  },
  "lint-staged": {
    "**/*.{ts,tsx,js,jsx}": [
      "yarn lint"
    ]
  },
  "packageManager": "yarn@4.5.0"
}
